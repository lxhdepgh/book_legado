# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/

# Virtual/local dependency directories
.testdeps/
.venv/
venv/
env/

# Build and packaging output
build/
dist/
wheelhouse/

# PyInstaller build artifacts (but keep the spec file)
build/LegadoReader/
!LegadoReader.spec

# Dart subproject packaging output
legodo_dart/backend/
legodo_dart/build/
legodo_dart/dist/

# Flet subproject packaging output
legodo_flet/dist/
legodo_flet/build/LegadoReader/

# Release packages (generated by build_release.py)
*.zip
*.exe
*.tar.gz
!*.spec


# Runtime caches and probes (reproducible test artifacts)
.cache/
.probe/
.tmp/
.tmp_pt/

# IDE and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime/user data must stay outside source control
bookshelf.json
reader-cache/
chromium-profile/
chromium-interactive-profile/

# Local book-source corpora under resource/ are user data, not source
resource/*.json

# Temporary files and logs produced by tools
*.tmp
*.log

# Scratch dirs from offline verification runs (pytest --basetemp / UI probes)
.tmp_pt/
.probe/
.zcode/

# Vendored reference sources downloaded for comparison
other_history/

# Recorded third-party page bodies used for offline engine replay
# (real scraped content from book-source hosts; must not enter source control)
tools/legado_diff/cases*.jsonl
tools/legado_diff/legado_out*.jsonl
tools/legado_diff/chunks/

# Gradle caches from the differential harness
tools/legado_diff/harness/.gradle/

# Pre-refactor snapshot kept locally for behaviour comparison (207M, not source control)
old_code/
flutter_client/backend/

# Reference code repositories (clone separately)
reference_code/legado-md3/
reference_code/legado-lyc486/
legado-md3-new/
